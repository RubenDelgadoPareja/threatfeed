# Copy to `.env` and adjust. One file, two consumers: docker-compose (Postgres container)
# and the app (pydantic-settings), both reading the same variables.
POSTGRES_USER=threatfeed
POSTGRES_PASSWORD=threatfeed
POSTGRES_DB=threatfeed
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Required only by the ingestors. One abuse.ch key works for URLhaus and ThreatFox.
# Get a free key at https://auth.abuse.ch/ and keep it out of git.
ABUSECH_AUTH_KEY=
# The previous name is still accepted: URLHAUS_AUTH_KEY=...
# URLhaus export to consume (recent.csv by default; other names are listed in your account).
URLHAUS_EXPORT=recent.csv

# Optional GeoIP enrichment: MaxMind GeoLite2 or DB-IP Lite (.mmdb).
# Paths are relative to the repo root (and to /app inside the containers).
# GEOIP_COUNTRY_DB=.cache/geoip/GeoLite2-Country.mmdb
# GEOIP_ASN_DB=.cache/geoip/GeoLite2-ASN.mmdb

# Celery / Beat (UTC)
REDIS_URL=redis://localhost:6379/0
CHECK_CACHE_TTL_SECONDS=300
URLHAUS_INTERVAL_MINUTES=60
THREATFOX_SCHEDULE_HOUR=0
THREATFOX_SCHEDULE_MINUTE=30